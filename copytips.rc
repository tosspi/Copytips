#include <windows.h>

#define IDD_SETTINGS 100

IDD_SETTINGS DIALOGEX 0, 0, 168, 56
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION L"Settings"
FONT 9, L"Segoe UI"
BEGIN
    CONTROL L"Start with Windows", 101, L"Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 12, 130, 10
    DEFPUSHBUTTON L"OK", IDOK, 58, 32, 48, 14
    PUSHBUTTON L"Cancel", IDCANCEL, 110, 32, 48, 14
END
