#include <windows.h>
#include "version.h"

#define IDD_SETTINGS 100

IDD_SETTINGS DIALOGEX 0, 0, 168, 56
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION L"Copytips"
FONT 9, L"Segoe UI"
BEGIN
    CONTROL L"Start with Windows", 101, L"Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 12, 130, 10
    DEFPUSHBUTTON L"OK", IDOK, 58, 32, 48, 14
    PUSHBUTTON L"Cancel", IDCANCEL, 110, 32, 48, 14
END

1 VERSIONINFO
FILEVERSION    APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "tosspi"
            VALUE "FileDescription",  "Copytips - clipboard toast notifier"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "copytips"
            VALUE "OriginalFilename", "copytips.exe"
            VALUE "ProductName",      "Copytips"
            VALUE "ProductVersion",   APP_VERSION_STR
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
